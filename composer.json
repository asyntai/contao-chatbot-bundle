{
    "name": "asyntai/contao-chatbot-bundle",
    "description": "Adds the Asyntai AI chat assistant to a Contao website. It answers visitor questions 24/7 using your own content.",
    "license": "MIT",
    "type": "contao-bundle",
    "keywords": [
        "contao",
        "chatbot",
        "chat",
        "ai",
        "assistant",
        "support",
        "live chat",
        "asyntai"
    ],
    "authors": [
        {
            "name": "Asyntai",
            "homepage": "https://asyntai.com"
        }
    ],
    "homepage": "https://asyntai.com",
    "support": {
        "email": "hello@asyntai.com",
        "issues": "https://github.com/asyntai/contao-chatbot-bundle/issues",
        "source": "https://github.com/asyntai/contao-chatbot-bundle",
        "docs": "https://asyntai.com/documentation/"
    },
    "require": {
        "php": "^8.2",
        "contao/core-bundle": "^5.3 || ^6.0",
        "symfony/config": "^6.4 || ^7.0 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-foundation": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0",
        "symfony/routing": "^6.4 || ^7.0 || ^8.0",
        "symfony/security-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/security-csrf": "^6.4 || ^7.0 || ^8.0",
        "symfony/yaml": "^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "conflict": {
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "autoload": {
        "psr-4": {
            "Asyntai\\ContaoChatbotBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Asyntai\\ContaoChatbotBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "contao-components/installer": true,
            "contao/manager-plugin": true,
            "php-http/discovery": false
        }
    },
    "extra": {
        "contao-manager-plugin": "Asyntai\\ContaoChatbotBundle\\ContaoManager\\Plugin"
    }
}
