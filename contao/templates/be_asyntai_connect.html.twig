{% set l = lang|default({}) %}
{% set connected = widgetId|default('') is not same as('') %}
<style>
    .asyntai-wrap{max-width:820px;padding:18px 15px}
    .asyntai-panel{background:#fff;border:1px solid #e0e0e0;padding:20px 22px;margin:0 0 16px;color:#222}
    .asyntai-panel h2{margin:0 0 12px;font-size:18px;font-weight:700;color:#111}
    .asyntai-panel h3{margin:0 0 10px;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:#6b6b6b}
    .asyntai-panel p{margin:0 0 10px;line-height:1.5}
    .asyntai-fine{color:#757575;font-size:12px}
    .asyntai-btn{display:inline-block;background:#111;color:#fff;border:1px solid #111;padding:9px 18px;font-size:14px;font-weight:600;cursor:pointer;line-height:1.4;border-radius:0}
    .asyntai-btn:hover,.asyntai-btn:focus{background:#000;color:#fff}
    .asyntai-state{font-size:15px;font-weight:600;color:#111}
    .asyntai-dot{display:inline-block;width:8px;height:8px;margin-right:9px;vertical-align:middle;background:#1a7f37}
    .asyntai-links{display:flex;gap:20px;flex-wrap:wrap}
    .asyntai-links a{color:#555;text-decoration:underline}
    .asyntai-links a.asyntai-danger{color:#b32d2e}
    .asyntai-alert{border:1px solid #e0e0e0;border-left-width:3px;padding:10px 14px;margin:0 0 16px;background:#fff;color:#222}
    .asyntai-check{display:flex;gap:10px;align-items:flex-start;margin:6px 0 14px;font-size:14px;cursor:pointer}
    .asyntai-check input{margin-top:3px}
    .asyntai-check small{display:block;color:#757575;font-size:12px;margin-top:2px}
</style>

<div class="asyntai-wrap" id="asyntai-connect-root"
     data-action-url="{{ actionUrl }}"
     data-token="{{ requestToken }}">

    <div id="asyntai-alert" class="asyntai-alert" style="display:none"></div>

    {% if not isAdmin %}
        <div class="asyntai-panel"><p>{{ l.adminOnly|default('') }}</p></div>
    {% elseif not connected %}
        <div class="asyntai-panel">
            <h2>{{ l.connectTitle|default('') }}</h2>
            <label class="asyntai-check">
                <input type="checkbox" id="asyntai-share-before" checked>
                <span>{{ l.shareBefore|default('') }}<small>{{ l.shareBeforeNote|default('') }}</small></span>
            </label>
            <p><button type="button" id="asyntai-connect" class="asyntai-btn">{{ l.getStarted|default('') }}</button></p>
            <p class="asyntai-fine">{{ l.popupNote|default('') }}</p>
        </div>
    {% else %}
        <div class="asyntai-panel">
            <p class="asyntai-state"><span class="asyntai-dot"></span>{{ accountEmail|default('') is not same as('') ? l.connectedAs|default('%s')|format(accountEmail) : l.connected|default('') }}</p>
            <p>{{ l.connectedNote|default('') }}</p>
            <p class="asyntai-links">
                <a href="https://asyntai.com/dashboard" target="_blank" rel="noopener">{{ l.dashboard|default('') }}</a>
                <a href="#" id="asyntai-disconnect" class="asyntai-danger">{{ l.disconnect|default('') }}</a>
            </p>
        </div>

        <div class="asyntai-panel">
            <h3>{{ l.pagesTitle|default('') }}</h3>
            <label class="asyntai-check">
                <input type="checkbox" id="asyntai-share"{{ sharing ? ' checked' : '' }}>
                <span><strong>{{ l.shareLabel|default('') }}</strong><small>{{ l.shareNote|default('') }}</small></span>
            </label>
            <p id="asyntai-share-status"></p>
        </div>
    {% endif %}
</div>

<script>
(function () {
    var root = document.getElementById('asyntai-connect-root');
    if (!root || root.getAttribute('data-ready') === '1') { return; }
    root.setAttribute('data-ready', '1');

    var strings = {{ jsStrings|raw }};
    var actionUrl = root.getAttribute('data-action-url');
    var requestToken = root.getAttribute('data-token');
    var popup = null;

    function say(message, ok) {
        var box = document.getElementById('asyntai-alert');
        if (!box) { return; }
        box.style.display = 'block';
        box.style.borderLeftColor = ok ? '#1a7f37' : '#b32d2e';
        box.textContent = message;
    }

    function call(action, data) {
        var body = new FormData();
        body.append('REQUEST_TOKEN', requestToken);
        Object.keys(data || {}).forEach(function (key) { body.append(key, data[key]); });

        return fetch(actionUrl.replace(/[^\/]+$/, action), {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Accept': 'application/json' },
            body: body
        }).then(function (response) {
            return response.text().then(function (raw) {
                var parsed = null;
                try { parsed = JSON.parse(raw); } catch (e) {}
                if (parsed && typeof parsed === 'object') {
                    if (response.ok) { return parsed; }
                    throw new Error(parsed.error || strings.failed);
                }
                var lost = new Error(strings.signedOut);
                lost.signedOut = true;
                throw lost;
            });
        });
    }

    // The window is opened inside the click, before any network call, or the
    // browser blocks it as unrequested.
    function connect(share) {
        popup = window.open('about:blank', 'asyntai_connect', 'width=820,height=740,scrollbars=yes,resizable=yes');
        if (!popup) { say(strings.blocked, false); return; }
        say(strings.preparing, true);

        call('prepare', { share: share ? '1' : '0' }).then(function (data) {
            popup.location = data.url;
            say(strings.waiting, true);
            poll(data.state, 0);
        }).catch(function (error) {
            if (popup) { try { popup.close(); } catch (e) {} }
            say(error.message || strings.failed, false);
        });
    }

    function poll(state, attempt) {
        if (attempt > 300) { say(strings.timeout, false); return; }

        call('poll', { state: state }).then(function (data) {
            if (data && data.ready && data.site_id) {
                say(strings.saving, true);
                return call('finish', {
                    site_id: data.site_id,
                    script_url: data.script_url || '',
                    account_email: data.account_email || ''
                }).then(function () { window.location.reload(); });
            }
            setTimeout(function () { poll(state, attempt + 1); }, 2000);
        }).catch(function (error) {
            if (error && error.signedOut) {
                if (popup) { try { popup.close(); } catch (e) {} }
                say(error.message, false);
                return;
            }
            setTimeout(function () { poll(state, attempt + 1); }, 3000);
        });
    }

    function refreshStatus(tries) {
        var box = document.getElementById('asyntai-share-status');
        var toggle = document.getElementById('asyntai-share');
        if (!box || !toggle) { return; }
        if (!toggle.checked) { box.textContent = ''; return; }

        call('status', {}).then(function (data) {
            var s = data && data.sync;
            if (!s) { box.textContent = strings.notYet; return; }
            if (s.status === 'syncing') {
                box.textContent = strings.reading;
                if (tries < 20) { setTimeout(function () { refreshStatus(tries + 1); }, 5000); }
                return;
            }
            if (s.status === 'failed') { box.textContent = strings.lastFailed.replace('%s', s.error || ''); return; }
            box.textContent = strings.shared.replace('%s', String(s.count || 0));
        }).catch(function () { box.textContent = ''; });
    }

    function toggleShare(toggle) {
        var on = !!toggle.checked;
        call('share', { enabled: on ? '1' : '0' }).then(function (data) {
            if (data && data.needs_connect) {
                toggle.checked = false;
                say(strings.reconnect, true);
                connect(true);
                return;
            }
            say(on ? strings.shareOn : strings.shareOff, true);
            refreshStatus(0);
        }).catch(function (error) {
            toggle.checked = !on;
            say(error.message || strings.failed, false);
        });
    }

    var connectButton = document.getElementById('asyntai-connect');
    if (connectButton) {
        connectButton.addEventListener('click', function (event) {
            event.preventDefault();
            var share = document.getElementById('asyntai-share-before');
            connect(share ? share.checked : false);
        });
    }

    var disconnectLink = document.getElementById('asyntai-disconnect');
    if (disconnectLink) {
        disconnectLink.addEventListener('click', function (event) {
            event.preventDefault();
            if (!window.confirm(strings.confirm)) { return; }
            call('disconnect', {}).then(function () {
                window.location.reload();
            }).catch(function (error) {
                say(error.message || strings.failed, false);
            });
        });
    }

    var shareToggle = document.getElementById('asyntai-share');
    if (shareToggle) {
        shareToggle.addEventListener('change', function () { toggleShare(shareToggle); });
    }

    refreshStatus(0);
})();
</script>
